; i2s.pio: 16-bit stereo I2S output for the PCM5102A.
;
; Copyright (C) 2026 Erica Synths
; SPDX-License-Identifier: GPL-3.0-only
;
; Same structure as the audio_i2s program in pico-extras (BSD-3-Clause,
; Raspberry Pi Ltd). Side-set pin 0 is BCK, side-set pin 1 is LRCK (BCK + 1),
; the OUT pin is DIN. Two PIO cycles per bit, so the state machine clock must
; be 2 * 32 * sample rate. Each 32-bit FIFO word is one frame: bits 31..16 are
; sent while LRCK is high (right), bits 15..0 while LRCK is low (left), so a
; little-endian {left, right} int16 pair can be sent as it is in memory.
; LRCK changes one BCK before the MSB of each word, as I2S requires.

.program lxr_i2s
.side_set 2

                    ;        /--- LRCK
                    ;        |/-- BCK
bitloop1:           ;        ||
    out pins, 1       side 0b10
    jmp x-- bitloop1  side 0b11
    out pins, 1       side 0b00
    set x, 14         side 0b01

bitloop0:
    out pins, 1       side 0b00
    jmp x-- bitloop0  side 0b01
    out pins, 1       side 0b10
public entry_point:
    set x, 14         side 0b11

% c-sdk {
static inline void lxr_i2s_program_init(PIO pio, uint sm, uint offset, uint data_pin, uint clock_pin_base)
{
    pio_sm_config c = lxr_i2s_program_get_default_config(offset);

    sm_config_set_out_pins(&c, data_pin, 1);
    sm_config_set_sideset_pins(&c, clock_pin_base);
    sm_config_set_out_shift(&c, false, true, 32);   /* MSB first, autopull every 32 bits */
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);

    pio_sm_init(pio, sm, offset, &c);

    const uint32_t pin_mask = (1u << data_pin) | (3u << clock_pin_base);
    pio_sm_set_pindirs_with_mask(pio, sm, pin_mask, pin_mask);
    pio_sm_set_pins(pio, sm, 0);

    pio_sm_exec(pio, sm, pio_encode_jmp(offset + lxr_i2s_offset_entry_point));
}
%}
